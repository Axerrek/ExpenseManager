@model ExpenseManager.Models.Expense
@using ExpenseManager.Models

<h2>Edytuj wydatek</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Opis:</label>
        <input asp-for="Description" />
    </div>

    <div>
        <label>Kwota:</label>
        <input asp-for="Price" type="number" step="0.01" />
    </div>

    <div>
        <label>Kategoria:</label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExpenseCategory>()"></select>
    </div>

    <div>
        <label>Data:</label>
        <input asp-for="Date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
    </div>

    <br />
    <button type="submit">Zapisz zmiany</button>
    <a asp-action="Index">Anuluj</a>
</form>