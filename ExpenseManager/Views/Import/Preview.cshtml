@model List<ExpenseManager.Models.ViewModels.ImportExpenseItemViewModel>

@{
    ViewData["Title"] = "Podgląd i kategoryzacja importu";
}

<div class="container mt-4">
    <h2>Podgląd zaimportowanych wydatków</h2>
    <p class="text-muted">Przejrzyj zaimportowane transakcje, dopasuj kategorie i zaznacz te, które chcesz zapisać.</p>

    <form asp-action="SaveImported" method="post">
        @Html.AntiForgeryToken()

        <div class="table-responsive mt-3">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 40px;">
                            <input type="checkbox" id="selectAll" class="form-check-input" checked />
                        </th>
                        <th style="width: 130px;">Data</th>
                        <th>Opis</th>
                        <th class="text-end" style="width: 130px;">Kwota pierw.</th>
                        <th class="text-center" style="width: 80px;">Waluta</th>
                        <th class="text-end" style="width: 130px;">Kwota (PLN)</th>
                        <th style="width: 200px;">Kategoria</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <!-- Zaznaczenie wiersza -->
                            <td class="text-center">
                                <input type="checkbox" asp-for="@Model[i].Selected" class="form-check-input item-checkbox" />
                            </td>

                            <!-- Data -->
                            <td>
                                <input type="date" asp-for="@Model[i].Date" class="form-control form-control-sm" />
                            </td>

                            <!-- Opis -->
                            <td>
                                <input type="text" asp-for="@Model[i].Description" class="form-control form-control-sm" />
                            </td>

                            <!-- Kwota pierwotna (Tylko do odczytu) -->
                            <td class="text-end align-middle">
                                <span>@Model[i].OriginalPrice.ToString("N2")</span>
                                <input type="hidden" asp-for="@Model[i].OriginalPrice" />
                            </td>

                            <!-- Waluta (Tylko do odczytu) -->
                            <td class="text-center align-middle">
                                <span class="badge bg-secondary">@Model[i].Currency</span>
                                <input type="hidden" asp-for="@Model[i].Currency" />
                            </td>

                            <!-- Wyliczona kwota PLN (Tylko do odczytu) -->
                            <td class="text-end align-middle fw-bold">
                                <span>@Model[i].Price.ToString("N2") zł</span>
                                <input type="hidden" asp-for="@Model[i].Price" />
                            </td>

                            <!-- Kategoria (Edytowalna) -->
                            <td>
                                <select asp-for="@Model[i].Category" asp-items="Html.GetEnumSelectList<ExpenseManager.Models.ExpenseCategory>()" class="form-select form-select-sm"></select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-3 mb-5">
            <a asp-action="Import" class="btn btn-outline-secondary">Anuluj</a>
            <button type="submit" class="btn btn-success">Zapisz wybrane wydatki</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('selectAll').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
    </script>
}